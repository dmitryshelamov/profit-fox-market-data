<Project>

    <!--
        The dependency rule of the layers: a project lists the projects it may reference directly, and the build fails on any other.
        Tests.Unit tests Domain and Application only; Tests.Integration may reference anything, so it has no list.
    -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.MarketData.Domain'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences></AllowedLayerReferences>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.MarketData.Application'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>ProfitFox.MarketData.Domain</AllowedLayerReferences>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.MarketData.Infrastructure'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>ProfitFox.MarketData.Application;ProfitFox.MarketData.Domain</AllowedLayerReferences>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.MarketData.Tests.Shared'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>ProfitFox.MarketData.Application;ProfitFox.MarketData.Domain</AllowedLayerReferences>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.MarketData.Tests.Unit'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>ProfitFox.MarketData.Application;ProfitFox.MarketData.Domain;ProfitFox.MarketData.Tests.Shared</AllowedLayerReferences>
    </PropertyGroup>

    <Target Name="CheckLayerReferences" BeforeTargets="ResolveProjectReferences" Condition="'$(CheckLayerReferences)' == 'true'">
        <ItemGroup>
            <_LayerReference Include="@(ProjectReference->'%(Filename)')"/>
            <_ForbiddenLayerReference Include="@(_LayerReference)" Exclude="$(AllowedLayerReferences)"/>
        </ItemGroup>
        <Error Condition="'@(_ForbiddenLayerReference)' != ''"
               Text="$(MSBuildProjectName) may reference only [$(AllowedLayerReferences)], not @(_ForbiddenLayerReference). The allowed references are listed in backend/Directory.Build.targets."/>
    </Target>

</Project>