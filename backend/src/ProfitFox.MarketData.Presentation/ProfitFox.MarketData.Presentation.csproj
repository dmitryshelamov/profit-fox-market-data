<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <UserSecretsId>20d57ea9-e324-402d-b170-5ad90c9d44c6</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Serilog.AspNetCore"/>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The client is generated too: the tests subscribe with it, and a consumer copies the proto and generates its own.
             The contracts import one another by file name (candle_feed.proto), so a consumer keeps the copies side by side. -->
        <Protobuf Include="Protos\candle_feed.proto" GrpcServices="Both" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\funding_payment_feed.proto" GrpcServices="Both" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\funding_rate_feed.proto" GrpcServices="Both" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\liquidation_feed.proto" GrpcServices="Both" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\long_short_ratio_feed.proto" GrpcServices="Both" ProtoRoot="Protos"/>
        <Protobuf Include="Protos\open_interest_feed.proto" GrpcServices="Both" ProtoRoot="Protos"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ProfitFox.MarketData.Infrastructure\ProfitFox.MarketData.Infrastructure.csproj"/>
    </ItemGroup>

</Project>
